{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Emit declarations straight into dist/ so the build needs no `cp -r`,
    // which was breaking Windows contributors.
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "types": []
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests", "examples", "react-example", "*.config.ts"]
}
